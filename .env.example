# SENTINEL secrets — copy to .env, never commit. Build plan §0.8.

# --- Broker (Groww) ---
# From groww.in -> Profile -> Trading APIs -> Generate API key -> "Generate TOTP token".
# GROWW_API_KEY is the long JWT. GROWW_TOTP_SEED is the 32-char base32 from the QR.
GROWW_API_KEY=
GROWW_TOTP_SEED=

# --- LLM ---
GROQ_API_KEY=
# Laptop Claude bridge over Tailscale / autossh reverse tunnel.
# Leave blank to skip straight to Groq.
CLAUDE_BRIDGE_URL=http://127.0.0.1:8787

# --- Web Push (VAPID) ---
# Generate with: python -m sentinel.scripts.gen_vapid   (or py_vapid)
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com

# --- PWA / API ---
PWA_ORIGIN=https://localhost:5173
API_SHARED_SECRET=change-me-long-random
TZ=Asia/Kolkata

# --- Backup (optional) ---
BACKUP_S3_BUCKET=
AWS_REGION=ap-south-1
