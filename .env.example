# VECTRA_QUANT secrets — copy to .env, never commit. Build plan §0.8.

# --- Broker Selection ---
# "dhan" is the only implemented adapter (backend/vectra_quant/brokers/dhan.py).
# Do not set this to "groww" or "zerodha" -- no working adapter exists for
# either, and the app will refuse to boot rather than fail confusingly deep
# inside broker selection.
BROKER_NAME=dhan

# --- Broker Secrets (DhanHQ API v2) ---
# Required -- the app refuses to start without both (brokers/dhan.py).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Web Push (VAPID) ---
# Generate with: python -m vectra_quant.scripts.gen_vapid   (or py_vapid)
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com

# --- PWA / API ---
# Required for any non-PAPER (LIVE) boot -- the app refuses to start in LIVE
# mode with either of these left at their insecure defaults.
PWA_ORIGIN=https://localhost:5173
API_SHARED_SECRET=change-me-long-random
TZ=Asia/Kolkata

# --- Backup (optional) ---
BACKUP_S3_BUCKET=
AWS_REGION=ap-south-1

# --- Order-flow recorder (optional, only for the Thunderbolt strategy) ---
# Directory the depth recorder and Thunderbolt paper trader write to.
ORDERFLOW_RECORDS_ROOT=./data/orderflow
